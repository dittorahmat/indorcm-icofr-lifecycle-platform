#!/bin/sh
# .githooks/pre-commit - fast repo gates on staged files (no new deps).
# Installed automatically by `npm install` (package.json "prepare" ->
# scripts/install-hooks.mjs). Manual fallback if the hook is missing:
#   git config core.hooksPath .githooks
# Runs only the deterministic delta gates and the cheap whole-tree invariants
# (seconds). Full type-check / lint / test stay in CI (verify.yml) - they take
# minutes on this repo.
#
# check:loc is deliberately NOT here even though it is delta-shaped: its
# grandfather rule can demand a split for a file you only bug-fixed, and a hook
# that blocks a legitimate one-line fix teaches `git commit --no-verify`, which
# would cost the three gates below their teeth. It runs in CI instead, where a
# failing gate is a review conversation rather than an obstacle to committing.
#
# Known property of every gate here: it reads the WORKING TREE file, not the
# staged blob. Content staged and then edited again is therefore judged as it
# is on disk; re-stage before committing or the gate is judging something else.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- src shared worker scripts | tr '\n' ' ')
# Workflow files are checked even when nothing else is staged: a broken one dies
# silently in CI (startup failure, zero jobs, nothing red), so the check must not
# depend on the STAGED fast path below.
WORKFLOWS=$(git diff --cached --name-only --diff-filter=ACMR -- .github/workflows | tr '\n' ' ')
if [ -n "$WORKFLOWS" ]; then
  node scripts/check-workflows.mjs || exit 1
fi
if [ -z "$STAGED" ]; then
  exit 0
fi
node scripts/check-crlf.mjs $STAGED || exit 1
node scripts/check-any-delta.mjs $STAGED || exit 1
node scripts/check-i18n.mjs $STAGED || exit 1
node scripts/check-worker-strings.mjs $STAGED || exit 1
node scripts/check-rbac-delta.mjs $STAGED || exit 1
# Whole-tree invariants (file-level facts, not delta facts). Cheap - each one
# reads the tree and exits; they catch the "green but false" class: a comment
# citing a deleted script, a hand-rolled i18n mock, a re-declared geometry
# constant.
node scripts/check-test-i18n.mjs || exit 1
node scripts/check-doc-refs.mjs || exit 1
node scripts/check-ocr-constants.mjs || exit 1
