#!/bin/sh
# .githooks/pre-commit - fast repo gates on staged files (no new deps).
# Installed automatically by `npm install` (package.json "prepare" ->
# scripts/install-hooks.mjs). Manual fallback if the hook is missing:
#   git config core.hooksPath .githooks
# Runs only the deterministic delta gates (seconds). Full type-check / lint /
# test stay in CI (verify.yml) - they take minutes on this repo.
#
# Known property of every gate here: it reads the WORKING TREE file, not the
# staged blob. Content staged and then edited again is therefore judged as it
# is on disk; re-stage before committing or the gate is judging something else.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- src shared worker scripts | tr '\n' ' ')
if [ -z "$STAGED" ]; then
  exit 0
fi
node scripts/check-loc.mjs $STAGED || exit 1
node scripts/check-any-delta.mjs $STAGED || exit 1
node scripts/check-i18n.mjs $STAGED || exit 1
node scripts/check-worker-strings.mjs $STAGED || exit 1
