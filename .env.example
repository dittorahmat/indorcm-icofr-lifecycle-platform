# Environment Variables Template
# Copy this to .env and fill in your secrets and connection strings

BETTER_AUTH_SECRET="your-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Primary instance connection string (pooled)
DATABASE_URL="postgresql://user:password@host-pooler.tech/neondb?sslmode=require&channel_binding=require"
SOURCE_DATABASE_URL="postgresql://user:password@host-pooler.tech/neondb?sslmode=require&channel_binding=require"

# Isolated non-primary target databases (pooled connection strings; direct/unpooled URLs are derived by stripping '-pooler')
DEMO_DATABASE_URL="postgresql://user:password@demo-host-pooler.tech/neondb?sslmode=require&channel_binding=require"
TEST_DATABASE_URL="postgresql://user:password@test-host-pooler.tech/neondb?sslmode=require&channel_binding=require"
TRIAL_DATABASE_URL="postgresql://user:password@trial-host-pooler.tech/neondb?sslmode=require&channel_binding=require"

# AI Integrations & Feature Flags
GEMINI_API_KEY=""
SKIP_LICENSE="true"
VITE_ENABLE_WORKFLOW_APPROVAL="false"
AI_CHAT_MODEL="gemini-2.5-flash-lite"
