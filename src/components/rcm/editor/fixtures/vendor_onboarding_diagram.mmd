        A2 --> A3[/"Dokumen Legal: NIB, SIUP, NPWP, Rekening"/]
    end

    subgraph PROCUREMENT["TIM PENGADAAN / PROCUREMENT"]
        A3 --> B1["1.2 Verifikasi Uji Tuntas Rekanan Baru"]
        B1 --> B2{"1.3 Apakah Dokumen Lengkap & Terverifikasi?"}
        B2 -- "Tidak" --> B3["1.4 Mengirimkan Surat Permintaan Kelengkapan Dokumen"]
        B3 --> A2
        B2 -- "Ya" --> B4["1.5 Melakukan Pemeriksaan Terhadap Daftar Hitam / Blacklist Vendor"]
        B4 --> B5[/"Berita Acara Hasil Uji Tuntas Rekanan"/]
    end

    subgraph LEGAL["BAGIAN HUKUM / LEGAL & COMPLIANCE"]
