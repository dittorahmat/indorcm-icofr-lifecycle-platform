        D2 --> E2(["Selesai: Rekanan Terdaftar Aktif"])
    end

    classDef activity fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0f172a;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a;
    classDef doc fill:#f1f5f9,stroke:#64748b,stroke-width:1px,stroke-dasharray: 5 5,color:#334155;
    classDef endpoint fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a;
    classDef storage fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#0f172a;

    class A2,B1,B3,B4,C1,C4,D1 activity;
    class B2,C2 decision;
    class A3,B5 doc;
    class A1,E1,E2 endpoint;
    class D2 storage;
