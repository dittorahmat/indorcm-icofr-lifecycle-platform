        C3 --> E1(["Selesai: Registrasi Ditolak"])
        C2 -- "Ya" --> C4["1.9 Penerbitan Rekomendasi Legalitas Rekanan"]
    end

    subgraph MANAGER["VP PROCUREMENT / PENGAMBIL KEPUTUSAN"]
